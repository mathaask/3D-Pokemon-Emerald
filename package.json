{
  "name": "emerald-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pokémon Emerald reimagined in 3D — a custom GBA core driving a Three.js renderer",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "symbols": "tsx tools/gen-symbols.ts",
    "headless": "tsx tools/headless.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "puppeteer-core": "^25.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
